{
  "name": "ant-concept-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "행위자 네트워크 이론(ANT) 개념도 생성기 — 논문을 넣으면 행위자·네트워크·번역·OPP·블랙박스·모순을 찾아 개념도로 그린다",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hosting": "tsc --noEmit && vite build --mode hosting",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "firebase": "^12.19.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
